Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:\.git|database|docs|codex-output|vendor)(?:/|$) - [F,L,NC]
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
</IfModule>

<FilesMatch "(?i)\.(sql|sqlite|bak|backup|old|orig|log|ini|env|yml|yaml|md|lock|dist|sh|ps1)$">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)^(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|web\.config)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
