        {"id":"40000000-0000-4000-8000-000000000000","comment":"Reset cookie/sesi agar test mandiri, termasuk saat dijalankan setelah test login.","command":"open","target":"apps/classes/Login.php?f=logout","targets":[],"value":""},
        {"id":"40000000-0000-4000-8000-000000000001","comment":"","command":"open","target":"apps/admin/login.php","targets":[],"value":""},
        {"id":"40000000-0000-4000-8000-000000000002","comment":"Tunggu form login selesai dirender agar test tidak flakey pada Firefox.","command":"waitForElementVisible","target":"css=#passwordInput","targets":[],"value":"5000"},
