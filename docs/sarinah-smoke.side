        {"id":"40000000-0000-4000-8000-000000000004","comment":"","command":"click","target":"css=#togglePassword","targets":[],"value":""},
        {"id":"40000000-0000-4000-8000-000000000005","comment":"Versi Selenium IDE ini tidak mendukung assertAttribute; cek perubahan type melalui selector CSS.","command":"assertElementPresent","target":"css=#passwordInput[type=\"text\"]","targets":[],"value":""},
        {"id":"40000000-0000-4000-8000-000000000006","comment":"","command":"click","target":"css=#togglePassword","targets":[],"value":""},
