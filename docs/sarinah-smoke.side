        {"id":"60000000-0000-4000-8000-000000000002","comment":"Jangan gunakan kredensial produksi di file .side.","command":"store","target":"admin","targets":[],"value":"adminUser"},
        {"id":"60000000-0000-4000-8000-000000000003","comment":"Isi CHANGE_ME dengan password akun testing lokal sebelum menjalankan test.","command":"store","target":"CHANGE_ME","targets":[],"value":"adminPass"},
