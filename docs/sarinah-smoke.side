  "tests": [
    {
      "id": "748c1e9d-bf1a-4c38-aec1-984da66f0101",
      "name": "AUTH-01 Landing page dan akses Login",
      "commands": [
        {"id":"10000000-0000-4000-8000-000000000000","comment":"Reset cookie/sesi agar test mandiri, termasuk saat dijalankan setelah test login.","command":"open","target":"apps/classes/Login.php?f=logout","targets":[],"value":""},
        {"id":"10000000-0000-4000-8000-000000000001","comment":"Gunakan URL eksplisit karena Selenium IDE menafsirkan '.' relatif terhadap endpoint logout sebelumnya.","command":"open","target":"http://localhost/sarinah-apps/","targets":[],"value":""},
        {"id":"10000000-0000-4000-8000-000000000002","comment":"Pastikan landing page termuat. Selector #hero stabil dan tidak dipengaruhi animasi header.","command":"assertElementPresent","target":"css=#hero","targets":[],"value":""},
        {"id":"10000000-0000-4000-8000-000000000003","comment":"Verifikasi halaman tujuan Login. Navigasi langsung dipakai agar test tidak flakey akibat animasi header Firefox.","command":"open","target":"apps/admin/login.php","targets":[],"value":""},
        {"id":"10000000-0000-4000-8000-000000000004","comment":"","command":"waitForElementVisible","target":"css=#login-frm","targets":[],"value":"5000"}
      ]
    },
    {
      "id": "1c7f6a89-0228-4217-b04e-8c535c640102",
