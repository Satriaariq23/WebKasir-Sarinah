        {"id":"60000000-0000-4000-8000-000000000009","comment":"Dashboard aktif menggunakan layout baru tanpa #kt_aside; heading ini menjadi indikator redirect login berhasil.","command":"waitForElementVisible","target":"xpath=//h1[normalize-space()='Dashboard']","targets":[],"value":"10000"}
