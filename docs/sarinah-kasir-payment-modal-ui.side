      "name": "PAYUI-01 Struktur modal pembayaran",
      "commands": [
        {"id":"11000000-0000-4000-8000-000000000001","comment":"Reset sesi agar test mandiri.","command":"open","target":"apps/classes/Login.php?f=logout","targets":[],"value":""},
        {"id":"11000000-0000-4000-8000-000000000002","comment":"","command":"open","target":"apps/admin/login.php","targets":[],"value":""},
        {"id":"11000000-0000-4000-8000-000000000003","comment":"","command":"type","target":"css=input[name=\"username\"]","targets":[],"value":"admin"},
        {"id":"11000000-0000-4000-8000-000000000004","comment":"Isi CHANGE_ME dengan password akun testing lokal sebelum menjalankan test.","command":"type","target":"css=#passwordInput","targets":[],"value":"CHANGE_ME"},
        {"id":"11000000-0000-4000-8000-000000000005","comment":"","command":"click","target":"css=.btn-login","targets":[],"value":""},
        {"id":"11000000-0000-4000-8000-000000000006","comment":"","command":"waitForElementVisible","target":"xpath=//h1[normalize-space()=\"Dashboard\"]","targets":[],"value":"10000"},
        {"id":"11000000-0000-4000-8000-000000000007","comment":"","command":"open","target":"apps/admin/?page=penjualan/kasir","targets":[],"value":""},
        {"id":"11000000-0000-4000-8000-000000000008","comment":"","command":"waitForElementVisible","target":"css=#kasir-form","targets":[],"value":"10000"},
        {"id":"11000000-0000-4000-8000-000000000009","comment":"Modal dibuka untuk menguji UI. Nilai total simulasi tidak membuat transaksi.","command":"executeScript","target":"document.querySelector('#sale_total').value='12000'; document.querySelector('#modal_amount_paid').value='0'; bootstrap.Modal.getOrCreateInstance(document.querySelector('#kasirPaymentModal')).show();","targets":[],"value":""},
        {"id":"11000000-0000-4000-8000-000000000010","comment":"","command":"waitForElementVisible","target":"css=#kasirPaymentModal.show","targets":[],"value":"5000"},
        {"id":"11000000-0000-4000-8000-000000000011","comment":"","command":"assertText","target":"css=#kasirPaymentModalLabel","targets":[],"value":"Konfirmasi Pembayaran"},
        {"id":"11000000-0000-4000-8000-000000000012","comment":"","command":"assertElementPresent","target":"css=#modal_amount_paid","targets":[],"value":""},
        {"id":"11000000-0000-4000-8000-000000000013","comment":"","command":"assertElementPresent","target":"css=#modal_btn_cancel","targets":[],"value":""},
